# AI Assistant API Key
GEMINI_API_KEY="your-gemini-api-key"

# Public application URL
NEXT_PUBLIC_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Blog CMS Authentication (Auth.js / NextAuth v5)
# -----------------------------------------------------------------------------
# Secret used to encrypt session tokens (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-32-byte-base64-auth-secret"

# GitHub OAuth Application Credentials
# Created at: https://github.com/settings/developers
# - Local Callback URL:  http://localhost:3000/api/auth/callback/github
# - Vercel Callback URL: https://your-production-domain.com/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# Server-Side Administrator GitHub Numeric ID Allowlist
# Note: Restricts admin access strictly by immutable numeric ID, NOT username.
ADMIN_GITHUB_ID="your-github-numeric-user-id"

# Optional: Comma-separated list of additional allowed GitHub numeric IDs
# ADMIN_GITHUB_IDS="123456789"

# -----------------------------------------------------------------------------
# Upstash Redis (Blog CMS Database)
# -----------------------------------------------------------------------------
# Obtain from Upstash Console (https://console.upstash.com)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
