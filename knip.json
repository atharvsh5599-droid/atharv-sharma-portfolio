{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,template,default,route}.{ts,tsx}",
    "next.config.ts"
  ],
  "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!"],
  "ignore": ["public/oneko/oneko.js"],
  "ignoreDependencies": [
    "@mdx-js/loader",
    "@mdx-js/react",
    "@next/mdx",
    "@types/mdx",
    "date-fns",
    "motion",
    "recharts",
    "rehype-stringify",
    "remark-frontmatter",
    "remark-gfm",
    "shiki",
    "@tailwindcss/typography",
    "eslint-config-next",
    "tailwindcss",
    "tw-animate-css",
    "postcss"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}
