{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/safety_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "code-formatter": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/auto_format.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
